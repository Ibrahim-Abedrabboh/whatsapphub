// Prisma schema — WhatsApp Broadcast System
// Single-business v1. `tenantId` can be added to top-level models for multi-tenant later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A tenant. Every top-level record carries a clientId (defaults to the bootstrap
// "default" client so existing single-tenant data keeps working). Per-client
// uniqueness + query scoping is layered on as multi-tenant is rolled out.
model Client {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String   @default("default")
  // E.164 without '+', e.g. 9665XXXXXXXX — unique per client (tenant)
  phone     String
  name      String?
  // Free-form template variables + opt-in metadata (source, date)
  attributes Json    @default("{}")
  tags      Json     @default("[]") // V2 M4 §2.6: string array, editable in Contact 360
  optedOut  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ContactListMembership[]
  recipients  BroadcastRecipient[]
  conversations Conversation[]

  @@unique([clientId, phone])
  @@index([optedOut])
}

model ContactList {
  id        String   @id @default(cuid())
  clientId  String   @default("default")
  name      String
  createdAt DateTime @default(now())

  memberships ContactListMembership[]
  broadcasts  Broadcast[]
  snapshots   ContactListSnapshot[]

  // No two lists in the same client may share a name (exact-case backstop; the
  // API additionally rejects case-insensitive clashes).
  @@unique([clientId, name])
}

// Point-in-time backup of a list's membership, so a change can be restored.
model ContactListSnapshot {
  id          String      @id @default(cuid())
  list        ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId      String
  listName    String      // list name when the snapshot was taken
  memberIds   Json        // array of contactIds in the list at snapshot time
  memberCount Int
  reason      String      @default("manual") // manual | pre-import
  createdAt   DateTime    @default(now())

  @@index([listId])
}

model ContactListMembership {
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId    String
  addedAt   DateTime    @default(now())

  @@id([contactId, listId])
  @@index([listId])
}

model Template {
  id            String   @id @default(cuid())
  clientId      String   @default("default")
  // Meta template name (must be approved)
  name          String
  language      String   @default("en")
  category      String   // MARKETING | UTILITY | AUTHENTICATION
  // Number of {{n}} body variables this template expects
  variableCount Int      @default(0)
  // Media header format if the template has one: IMAGE | DOCUMENT | VIDEO (null = none/text)
  headerFormat  String?
  // True if the template has a COPY_CODE (coupon) button — the broadcast must supply a code.
  copyCode      Boolean  @default(false)
  // Carousel card definitions (media URL + format per card) so sends can reuse them.
  // [{ format: "IMAGE"|"VIDEO", mediaUrl, body, buttonText?, buttonUrl? }]
  cards         Json?
  status        String   @default("APPROVED") // mirror of Meta status
  createdAt     DateTime @default(now())

  broadcasts Broadcast[]

  @@unique([clientId, name, language])
  @@index([clientId])
}

// Dynamic segment (V2 M4 §2.7) — a saved rule set evaluated against contacts
// at preview/send time, so membership is always live (no materialized rows).
// rules = { match: "all"|"any", conditions: [{ field, op, value? }] } — see lib/segments.ts.
model Segment {
  id        String   @id @default(cuid())
  clientId  String   @default("default")
  name      String
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broadcasts Broadcast[]

  @@unique([clientId, name])
}

model Broadcast {
  id          String   @id @default(cuid())
  clientId    String   @default("default")
  template    Template @relation(fields: [templateId], references: [id])
  templateId  String
  // Audience: exactly one of list / segment (enforced in lib/broadcast.ts).
  list        ContactList? @relation(fields: [listId], references: [id])
  listId      String?
  segment     Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentId   String?
  // A/B test (V2 M4 §2.7): variant B links to its parent A; labels "A"/"B".
  variantOf     String?
  variantLabel  String?
  variantParent Broadcast?  @relation("BroadcastVariants", fields: [variantOf], references: [id], onDelete: SetNull)
  variants      Broadcast[] @relation("BroadcastVariants")
  status      BroadcastStatus @default(DRAFT)
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  // Saved so failed recipients can be recomputed + retried later.
  variableMap Json     @default("[]")
  // Media URL for the template's header (when the template has a media header).
  headerMediaUrl String?
  // Coupon code for a COPY_CODE button template.
  couponCode  String?
  scheduledAt DateTime?           // null = send immediately
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  recipients BroadcastRecipient[]

  @@index([status])
}

// Link tracking (V2 M4 §2.9) — a short code that 302-redirects via the public
// /r/[code] route, logging a LinkClick on the way. One per broadcast (variant)
// when a tracked URL is supplied; standalone links are possible too.
model ShortLink {
  id          String   @id @default(cuid())
  clientId    String   @default("default")
  code        String   @unique
  targetUrl   String
  broadcastId String?
  createdAt   DateTime @default(now())

  clicks LinkClick[]

  @@index([broadcastId])
}

model LinkClick {
  id          String    @id @default(cuid())
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
  shortLinkId String
  // Plain string (no FK): attribution comes from an untrusted URL param on a
  // public route — a bogus id must not make the click insert fail.
  contactId   String?
  createdAt   DateTime  @default(now())

  @@index([shortLinkId])
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

model BroadcastRecipient {
  id          String   @id @default(cuid())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String
  contact     Contact   @relation(fields: [contactId], references: [id])
  contactId   String
  // Meta message id returned on send; key for matching webhook status
  wamid       String?  @unique
  status      RecipientStatus @default(PENDING)
  error       String?
  updatedAt   DateTime @updatedAt

  events MessageEvent[]

  @@unique([broadcastId, contactId]) // idempotency
  @@index([status])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model MessageEvent {
  id          String   @id @default(cuid())
  recipient   BroadcastRecipient? @relation(fields: [recipientId], references: [id])
  recipientId String?
  wamid       String?
  // status callback or inbound message
  type        String   // status:sent|delivered|read|failed | inbound
  payload     Json
  createdAt   DateTime @default(now())

  @@index([wamid])
}

model RecurringCampaign {
  id          String   @id @default(cuid())
  clientId    String   @default("default")
  name        String
  templateId  String   // plain ids (no FK) to keep it decoupled
  listId      String
  variableMap Json     @default("[]")
  cron        String   // 5-field cron, evaluated in UTC by the scheduler
  active      Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([active])
}

model User {
  id           String   @id @default(cuid())
  clientId     String   @default("default")
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("MEMBER") // SUPERADMIN | ADMIN | MEMBER
  createdAt    DateTime @default(now())

  assignedConversations Conversation[] @relation("ConversationAssignee")
  authoredNotes         InternalNote[] @relation("NoteAuthor")

  @@index([clientId])
}

// No-code WhatsApp Cloud API connection settings (single row, id="default").
// Values here override the env defaults at runtime — see lib/waConfig.ts.
model WhatsAppConfig {
  id                 String   @id @default(cuid())
  clientId           String   @unique @default("default")
  phoneNumberId      String?
  businessAccountId  String?
  appId              String? // Meta App ID — needed for resumable media upload (template header samples)
  accessToken        String?
  appSecret          String?
  webhookVerifyToken String?
  graphApiVersion    String?
  // Embedded Signup (V2 M1): set when the connection was established via Meta's
  // one-click OAuth flow rather than manual entry. tokenExpiresAt is null for a
  // long-lived system-user token (no expiry reported by Graph).
  wabaAutoConnected  Boolean   @default(false)
  tokenExpiresAt     DateTime?
  // Auto-pause (V2 M4 §2.9): set by the quality poller when the number drops
  // to RED; blocks new broadcasts + holds queued sends until manually resumed.
  sendPaused         Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
}

// Commerce (V2 M5 §2.10) — the client's Meta Commerce Manager catalog. One per
// tenant; products are synced from Graph on demand and cached locally so the
// inbox product picker doesn't hit Meta on every open.
model CommerceCatalog {
  id            String    @id @default(cuid())
  clientId      String    @unique @default("default")
  metaCatalogId String
  name          String?
  lastSyncedAt  DateTime?
  updatedAt     DateTime  @updatedAt
}

// A synced catalog product (V2 M5 §2.10). retailerId is Meta's
// product_retailer_id — the key used in product messages and order webhooks.
model Product {
  id           String   @id @default(cuid())
  clientId     String   @default("default")
  retailerId   String
  name         String
  priceText    String? // formatted by Meta, e.g. "SAR 25.00"
  currency     String?
  imageUrl     String?
  availability String? // in stock | out of stock (as reported)
  raw          Json?   // full Graph node for fields we don't model yet
  updatedAt    DateTime @updatedAt

  @@unique([clientId, retailerId])
  @@index([clientId])
}

// Point-in-time reading of a phone number's Meta quality rating + messaging
// tier (V2 M4 §2.9). Written by the worker's repeatable quality poll.
model QualitySnapshot {
  id            String   @id @default(cuid())
  clientId      String   @default("default")
  phoneNumberId String
  qualityRating String? // GREEN | YELLOW | RED | UNKNOWN (as reported)
  messagingTier String? // e.g. TIER_1K / TIER_10K / TIER_100K / TIER_UNLIMITED
  capturedAt    DateTime @default(now())

  @@index([clientId, capturedAt])
}

// A two-way conversation thread with one peer (per client, per channel). The 24h
// customer-service window is derived from lastInboundAt.
model Conversation {
  id            String    @id @default(cuid())
  clientId      String
  // Per-channel peer identifier: E.164 (WhatsApp), IGSID (Instagram), PSID
  // (Messenger). Opaque string; uniqueness is scoped by (clientId, channel).
  phone         String
  channel       String    @default("WHATSAPP") // WHATSAPP | INSTAGRAM | MESSENGER
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String?
  lastInboundAt DateTime? // last message FROM the customer → drives the 24h window
  lastMessageAt DateTime  @default(now())
  lastPreview   String?
  unread        Int       @default(0)
  createdAt     DateTime  @default(now())

  // Team collaboration (V2 §2.3): helpdesk status + agent assignment. closedAt
  // and firstResponseAt also feed the (compute-on-read) SLA timers.
  status          String    @default("OPEN") // OPEN | PENDING | CLOSED
  assignedTo      User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId    String?
  firstResponseAt DateTime? // first OUT message after an inbound → first-response SLA
  closedAt        DateTime? // set when status → CLOSED, cleared on reopen

  aiSummary       String?   // V2 M3 §2.4: one-paragraph Claude summary (on demand)

  messages Message[]
  notes    InternalNote[]

  @@unique([clientId, channel, phone])
  @@index([clientId, lastMessageAt])
  @@index([clientId, status])
  @@index([clientId, assignedToId])
}

model Message {
  id             String   @id @default(cuid())
  clientId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  channel        String   @default("WHATSAPP") // WHATSAPP | INSTAGRAM | MESSENGER
  direction      String   // IN | OUT
  type           String   @default("text") // text|image|document|audio|video|sticker|interactive|reaction|location|template
  text           String?
  mediaId        String?  // WhatsApp: Graph media id; Instagram/Messenger: inbound CDN URL
  mediaMime      String?
  mediaFilename  String?
  wamid          String?  @unique // generic external message id (WhatsApp wamid / IG · Messenger mid)
  status         String?  // OUT only: SENT|DELIVERED|READ|FAILED
  error          String?
  aiTags         Json?    // V2 M3 §2.4: { intent, sentiment } from on-demand classification
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([wamid])
}

// WhatsApp Flow (V2 M3 §2.5): native in-chat form, submitted to Meta like a
// template. Dark until the Meta app has Flows access.
model Flow {
  id         String   @id @default(cuid())
  clientId   String
  name       String
  definition Json
  metaId     String?  // Meta-returned flow id once submitted
  status     String   @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
}

// No-code inbound automation rule (V2 M3 §2.5): trigger (keyword | away) →
// action (sendText). Evaluated best-effort in the inbound webhook.
model AutomationRule {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  enabled   Boolean  @default(true)
  trigger   Json
  action    Json
  createdAt DateTime @default(now())

  @@unique([clientId, name])
  @@index([clientId, enabled])
}

// Per-client FAQ / knowledge base used to ground AI FAQ answers (V2 M3 §2.4).
model KnowledgeDoc {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, title])
  @@index([clientId])
}

// Reusable per-client reply snippet (V2 §2.3). Body may contain {{name}}/{{phone}}
// placeholders substituted from the conversation's contact when inserted.
model CannedReply {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  shortcut  String?
  body      String
  createdAt DateTime @default(now())

  @@unique([clientId, title])
  @@index([clientId])
}

// Agent-only note on a conversation (V2 §2.3). Never sent to the customer.
model InternalNote {
  id             String   @id @default(cuid())
  clientId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([clientId])
}

// Per-client connection of a non-WhatsApp Meta messaging asset (Instagram
// business account / Facebook Page). WhatsApp keeps its own WhatsAppConfig.
// Used to route inbound webhooks (by assetId) and authorize outbound sends.
model ChannelConnection {
  id              String   @id @default(cuid())
  clientId        String   @default("default")
  channel         String   // INSTAGRAM | MESSENGER
  assetId         String   // entry.id we route inbound by (IG business id / Page id)
  pageId          String?
  igBusinessId    String?
  accessToken     String?
  appSecret       String?
  verifyToken     String?
  graphApiVersion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, channel])
  @@unique([channel, assetId])
  @@index([clientId])
}

model OptOut {
  id        String   @id @default(cuid())
  clientId  String   @default("default")
  phone     String
  source    String   @default("keyword") // keyword | manual | api
  createdAt DateTime @default(now())

  @@unique([clientId, phone])
  @@index([clientId])
}
