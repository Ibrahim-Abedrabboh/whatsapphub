# ============================================================
# Opal Hotel Social Media Growth Hub — production .env
# Copy to `.env` at the repo root, fill EVERY value, then:
#   docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# ── Database (Postgres container) ──
POSTGRES_USER=opal
POSTGRES_PASSWORD=REPLACE_with_a_strong_password
POSTGRES_DB=opalhub
# The app reaches Postgres by the compose service name "postgres":
DATABASE_URL=postgresql://opal:REPLACE_with_a_strong_password@postgres:5432/opalhub

# ── Redis (container) ──
REDIS_URL=redis://redis:6379

# ── App & auth (required) ──
NODE_ENV=production
# A 32+ char secret — generate with:  openssl rand -hex 32
AUTH_JWT_SECRET=REPLACE_openssl_rand_hex_32
ADMIN_EMAIL=admin@opalhotel.com
# bcrypt HASH of the admin password (never the plaintext) — generate with:
#   node scripts/hash-password.mjs 'your-admin-password'
ADMIN_PASSWORD_HASH=REPLACE_bcrypt_hash

# ── Meta / WhatsApp (required) ──
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
META_APP_SECRET=
# A secret phrase you choose; paste the same value into the Meta webhook setup:
WA_WEBHOOK_VERIFY_TOKEN=choose-any-secret-phrase

# ── Meta app (media uploads + one-click onboarding; recommended) ──
WA_APP_ID=
META_APP_ID=
META_CONFIG_ID=
GRAPH_API_VERSION=v21.0

# ── Sending ──
WA_MPS=80
OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE

# ── AI assist (optional — leave blank to keep AI features off) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Cloudflare Tunnel ──
# From Cloudflare Zero Trust → Networks → Tunnels → create a tunnel → copy its token.
CLOUDFLARE_TUNNEL_TOKEN=
